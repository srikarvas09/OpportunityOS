# ── Railway deployment ────────────────────────────────────────────────────────
# When you add a MySQL service on Railway, it auto-injects MYSQL_URL.
# You do NOT need to set the DB_* vars below when deploying on Railway.
MYSQL_URL=mysql://user:password@host:port/database

# ── Local development ─────────────────────────────────────────────────────────
# Used as fallback when MYSQL_URL is not set (i.e., your local machine).
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=opportunityos

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Frontend URL (optional) ───────────────────────────────────────────────────
# Set this to your Vercel production URL to whitelist it in CORS.
# Example: https://opportunityos.vercel.app
FRONTEND_URL=
